NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. One of these is required; Groq is used when both are set.
# Groq free plan: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Optional; defaults to qwen/qwen3.8-27b (free plan, reads photos)
GROQ_MODEL=qwen/qwen3.8-27b
# Gemini (paid for new keys): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
